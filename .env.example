# Estech AI Business Copilot environment variables
# Copy this file to .env and fill in values for your environment.
# Never commit real credentials to Git.

# Application
NEXT_PUBLIC_APP_NAME="Estech AI Business Copilot"
NEXT_PUBLIC_SITE_URL="https://your-app-domain.com"

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# AI Providers (priority order: Gemini > Groq > Mistral)
GEMINI_API_KEY=""
GROQ_API_KEY=""
MISTRAL_API_KEY=""
MISTRAL_API_URL="https://api.mistral.ai/v1/chat/completions"

# Search Engine API Keys
TAVILY_API_KEY=""

# --- External authentication integrations ---
# These require manual configuration in the provider dashboards and
# in the Supabase Auth settings. Do not commit real credentials.

# Cloudflare Turnstile (public site key only in browser code)
# Secret key goes ONLY in Supabase Auth > CAPTCHA settings.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-turnstile-site-key"

# Error / performance monitoring (optional)
NEXT_PUBLIC_SENTRY_DSN=""

# Legacy / local development only
JWT_SECRET="your-development-secret-key-change-in-production"
DATABASE_URL="postgresql://user:password@localhost:5432/estecc"

# --- OAuth provider feature flags ---
# Enable a provider ONLY after its credentials are configured in Supabase
# Auth > Providers and the provider console (Google Cloud / Microsoft Entra /
# GitHub OAuth Apps). Unconfigured providers are hidden by default.
# Do not commit real client secrets here; secrets live in Supabase only.

NEXT_PUBLIC_ENABLE_GOOGLE_OAUTH="false"
NEXT_PUBLIC_ENABLE_MICROSOFT_OAUTH="false"
NEXT_PUBLIC_ENABLE_GITHUB_OAUTH="false"

# Guest demo mode (read-only synthetic demo, no real Supabase writes).
NEXT_PUBLIC_ENABLE_GUEST_DEMO="true"
